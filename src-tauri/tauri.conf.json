{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PEW",
  "version": "0.1.0",
  "identifier": "app.pew.viewer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PEW",
        "width": 430,
        "height": 900,
        "minWidth": 380,
        "minHeight": 400,
        "decorations": false,
        "resizable": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
